# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it holds real API keys.
# ---------------------------------------------------------------------------

PORT=8787

# Which provider serves new sessions: decart | vidu
# Switchable at runtime from the admin panel; this is only the boot default.
ACTIVE_PROVIDER=decart

# Global kill switch. "true" refuses ALL session minting, both providers.
KILL_SWITCH=false

# --- Decart -----------------------------------------------------------------
# Server-side key from https://platform.decart.ai. Never reaches the browser.
DECART_API_KEY=dct_your_key_here
DECART_MODEL=lucy-vton-3.5
# Lucy VTON 3.5 realtime is billed at $0.02/sec of 720p video.
DECART_USD_PER_SECOND=0.02
# Ledger refuses to mint once cumulative billed seconds pass this.
# 300s ~= $6 ~= 60% of a 1,000-credit balance.
DECART_BUDGET_SECONDS=300

# --- Vidu -------------------------------------------------------------------
# Not yet obtained. Leave as-is until you have a key; the provider will
# simply report itself unconfigured and the admin panel will grey it out.
VIDU_API_KEY=
# api.vidu.com (global) or api.vidu.cn (China). Keys are region-specific.
VIDU_HOST=api.vidu.com
# S2-Editing is billed at 1 credit/sec, $0.005/credit globally.
VIDU_USD_PER_SECOND=0.005
# 2400s = $12, leaving headroom under a $15 balance.
VIDU_BUDGET_SECONDS=2400

# --- Session guardrails (apply to every provider) ---------------------------
MAX_SESSION_SECONDS=60
# Live default for new sessions; adjustable from the admin panel, never above the cap.
DEFAULT_SESSION_SECONDS=15
# Each "+15s" click extends by this much, up to MAX_SESSION_EXTENSIONS times.
EXTENSION_SECONDS=15
MAX_SESSION_EXTENSIONS=3
# Hard refusal above this many simultaneous sessions.
MAX_CONCURRENT=2
# Seconds the client has to actually connect before its slot is reclaimed.
CONNECT_WINDOW_SECONDS=45

# --- Google sign-in ---------------------------------------------------------
# Blank runs without authentication (the default while developing). The client
# ID can also be set from the dashboard's Settings tab without a redeploy.
#
# ONE OAuth client signs in both the dashboard and the extension. Create it at
# https://console.cloud.google.com/apis/credentials , type "Web application":
#   Authorised JavaScript origins: https://app.tryoncam.com  (and http://localhost:8787)
#   Authorised redirect URIs:      https://aadnmnhilcphhjnchilngaeandeldngc.chromiumapp.org/
# The redirect URI is the extension's (chrome.identity.launchWebAuthFlow). The
# dashboard's Settings tab shows both values ready to copy.
GOOGLE_CLIENT_ID=

# Signs sign-in tokens and cookies. Generate one: openssl rand -hex 32
# REQUIRED on serverless: left blank, each instance makes up its own and a
# sign-in on one instance is rejected by the next.
SESSION_SECRET=
SESSION_TTL_HOURS=168

# false lets an unauthenticated visitor still read the dashboard once sign-in
# is configured. Writes always require a session.
AUTH_REQUIRED=true

# --- Deployment (serverless) -------------------------------------------------
# Upstash Redis. REQUIRED when running on Vercel: serverless has no shared
# memory and no disk, so without it the ledger would vanish and the budget and
# concurrency guards would silently stop working. The server refuses to boot
# serverless without these.
# Add from Vercel -> Storage -> Upstash for Redis (free tier is plenty here),
# which sets these automatically, or paste them from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Interim shared password for the deployed dashboard, until Google sign-in is
# configured. Blank = no gate (correct for localhost, NOT for a public URL).
# /api/settings and /api/health stay open so the extension can read copy.
DASHBOARD_PASSWORD=

# Operators who may open the dashboard, comma separated. Anyone else who signs
# in with Google is a customer. (ALLOWED_EMAILS is the old name for this.)
ADMIN_EMAILS=

# --- Accounts and payments ------------------------------------------------------
# Supabase: users, credits, plans and payments. The URL is not secret; the
# secret key (sb_secret_…, Settings -> API Keys) must never reach a browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe. A test key (sk_test_…) sells nothing real. The webhook secret
# (whsec_…) comes from the endpoint you add in Stripe for
# <PUBLIC_URL>/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends customers back to after checkout.
PUBLIC_URL=https://app.tryoncam.com

# Encrypts keys saved from the dashboard's Environment tab. Set it on Vercel.
# Generate with: openssl rand -hex 32. Losing it means re-entering those keys.
CONFIG_ENCRYPTION_KEY=
