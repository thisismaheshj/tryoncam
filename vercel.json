{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/",
      "permanent": false
    },
    {
      "source": "/account",
      "destination": "/account/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public"
}
