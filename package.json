{
  "name": "vton-smoke-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time virtual try-on smoke test. Provider-agnostic backend (Decart | Vidu) with hard budget guardrails.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:sdk": "esbuild scripts/sdk-entry.js --bundle --format=esm --platform=browser --outfile=extension/vendor/decart-sdk.js && cp node_modules/@decartai/sdk/dist/realtime/browser/frame-metadata-worker.js extension/vendor/",
    "prestart": "npm run build:sdk",
    "predev": "npm run build:sdk",
    "build:ext": "npm run build:sdk",
    "package:ext": "bash scripts/package-extension.sh"
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.1",
    "@supabase/supabase-js": "^2.117.1",
    "express": "^4.21.2",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
